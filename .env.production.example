# ==============================================================================
# KB J Capital Intranet — production environment template
#
# For docker compose:   cp .env.production.example .env   (next to
# docker-compose.yml), then replace EVERY placeholder before going live.
# Never commit or share the filled-in file.
#
# For Kubernetes: the same values go into the k8s Secret / config — see the
# "Deploy (Kubernetes)" section of README.md.
# ==============================================================================

# --- PostgreSQL (the compose postgres service) ---------------------------------
POSTGRES_USER=kbj
# Strong password for the compose postgres superuser account.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=kbj_intranet

# Leave DATABASE_URL unset to use the compose postgres service (recommended).
# Uncomment and edit ONLY to point the app at an external PostgreSQL instance:
# DATABASE_URL=postgresql://user:password@db-host.internal:5432/kbj_intranet

# --- Application (all required in production) ----------------------------------
# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_32_plus_random_characters

# Bootstrap admin, created automatically when the users store is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# --- Optional (defaults shown) --------------------------------------------------
# Uploaded-file storage inside the app container (mount a writable volume here)
# UPLOAD_DIR=/app/uploads
# PORT=3000
# HOST=0.0.0.0
