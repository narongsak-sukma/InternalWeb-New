# KB J Capital Intranet Portal — environment configuration
# Copy to .env for local development. Production values are managed via
# docker-compose / Kubernetes secrets (see .env.production.example).

# PostgreSQL connection string. Leave EMPTY for local dev without a database:
# the server then runs with in-memory stores (data resets on every restart).
# Example: postgresql://kbj:kbj@localhost:5432/kbj_intranet
DATABASE_URL=

# Secret used to sign session tokens (HMAC-SHA256). REQUIRED in production
# (NODE_ENV=production refuses to start without it); 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Bootstrap administrator, created automatically when the users table is empty.
# Defaults in dev (in-memory): admin / ChangeMe@KBJ2026!  — change for any real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# File uploads (POST /api/upload, maker and above). 10MB max per file.
UPLOAD_DIR=./uploads

# HTTP server binding.
PORT=3000
HOST=0.0.0.0

# Set to "production" when serving built assets (enables secure cookies and
# the SESSION_SECRET hard requirement).
NODE_ENV=development
